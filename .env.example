# ========================================================
# CogniStudy AI — Environment Variables
# ========================================================

PORT=3001

# Choose your preferred LLM provider. The backend auto-detects whichever key is supplied.
# If no key is supplied, CogniStudy smoothly runs in Mock Fallback Mode
# so the app works immediately out of the box without setup barriers.

# 1. Google Gemini (Recommended - free tier available at https://aistudio.google.com/)
GEMINI_API_KEY=

# 2. Groq (Ultra-fast Llama 3 - free tier available at https://console.groq.com/)
GROQ_API_KEY=

# 3. OpenAI (gpt-4o-mini)
OPENAI_API_KEY=
