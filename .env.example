# ========================================================
# CogniStudy AI — Environment Variables
# ========================================================

PORT=3001

# Hugging Face Inference Router API Key
# Sign up at https://huggingface.co/settings/tokens to get your token
HUGGING_FACE_API_KEY=hf_your_token_here
HUGGING_FACE_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Other optional providers supported:
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=
